# StudioClear local configuration — copy to `.env` and fill in.
# `.env` is git-ignored. In Cloud Run, PARALLEL_API_KEY comes from Secret Manager
# via the service account (see sol.md E1.6 / E3.2), NOT from a .env file.

# --- Parallel (the runtime research/evidence engine) ---
PARALLEL_API_KEY=your-parallel-api-key

# --- Google Cloud / Vertex AI (Gemini) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Route google-genai through Vertex AI (uses Application Default Credentials).
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Models (GA on Vertex AI — see sol.md E1.3; do not use 1.5-*) ---
GEMINI_EXTRACTION_MODEL=gemini-2.5-pro
GEMINI_NORMALIZER_MODEL=gemini-2.5-flash

# --- Evidence store: "json" (P0 local) or "firestore" ---
EVIDENCE_STORE=json
